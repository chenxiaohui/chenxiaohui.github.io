    <item>
      <title>AI这些年的进步，主要靠的是什么</title>
      <link>https://chenxiaohui.me/2025/12/27/ai/</link>
      <guid isPermaLink="true">https://chenxiaohui.me/2025/12/27/ai/</guid>
      <pubDate>Sat, 27 Dec 2025 17:35:00 -0800</pubDate>
      <author>Harry Chen</author>
      <description>最近读到一篇有意思的论文 On the Origin of Algorithmic Progress in AI，结论有点出乎意料。</description>
      <media:content url="https://harrychen.oss-cn-beijing.aliyuncs.com/2021-02-08-171714.png" />
    </item>
        
      
    
      
    <item>
      <title>大模型时代的一些感想</title>
      <link>https://chenxiaohui.me/2025/12/21/reflections-on-the-age-of-large-models/</link>
      <guid isPermaLink="true">https://chenxiaohui.me/2025/12/21/reflections-on-the-age-of-large-models/</guid>
      <pubDate>Sun, 21 Dec 2025 06:00:00 -0800</pubDate>
      <author>Harry Chen</author>
      <description>这个博客好久没更新了，时间过去了快有四五年了吧。中间经历了疫情，疫情过后感觉什么都变了，整个世界好像进入了一个完全不同的时代。经济和社会发展这些年感觉有点停滞，但AI这块变化太大了。2022年底ChatGPT刚出来的时候还只是个新鲜玩意，到现在我写代码、写文档基本离不开它了。说实话，用大模型的时候偶尔会有种奇怪的感觉——这玩意好像真的懂我在说什么。以前的AI感觉就是个工具，但现在用着大模型，有时候会想，会不会哪天人反而变成AI的工具了？这不是开玩笑，是真的有这种担忧。想起来之前看过的美剧《疑犯追踪》，里面就讲AI无处不在地监控和帮助人类的故事。感觉离那个世界真的不远了。虽然科幻里想象的机器人大战没发生，但变化已经在发生了。我身边做翻译的朋友去年就转行了，客户直接用AI翻译然后找人校对，价格压到原来的三分之一。这种事以后只会越来越多。未来会怎样？说实话我也不知道。但与其焦虑，不如先把手...</description>
      <media:content url="https://harrychen.oss-cn-beijing.aliyuncs.com/2026-01-18-220851.png" />
    </item>
        
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
      
    
